---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/layout/Footer.astro";

const siteUrl = "https://www.steuerberatung-finke.de";
const title = "Sophie Finke · Steuerberatung";
const description = "Steuerberatung mit Klarheit: Betriebsprüfungen, Unternehmensumstrukturierungen, Nachfolgeplanung und Beratung für Berater in NRW.";
const ogImage = `${siteUrl}/og-image.jpg`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "AccountingService",
  name: "Sophie Finke Steuerberatung",
  url: siteUrl,
  logo: siteUrl + "/logo.svg",
  image: ogImage,
  telephone: "+49 171 6194510",
  email: "kontakt@steuerberatung-finke.de",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Am Steigerturm 16",
    postalCode: "45772",
    addressLocality: "Marl",
    addressCountry: "DE",
  },
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl + Astro.url.pathname} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#F7F9FC" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card (wird auch von vielen Messengern genutzt) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="bg-[#FAFAFA] text-gray-900">
    <Navbar />
    <main class="pt-20">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
