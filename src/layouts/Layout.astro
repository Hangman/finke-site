---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
    <link rel="preload" as="font" href="/fonts/head1.woff2" type="font/woff2" crossorigin />
    <link rel="preload" as="font" href="/fonts/head2.woff2" type="font/woff2" crossorigin />
  </head>
  <body class="bg-[#FAFAFA] text-gray-900">
    <Navbar />
    <main class="pt-16">
      <slot />
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
