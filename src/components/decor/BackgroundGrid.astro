---
interface Props {
  class?: string;
  size?: number; // Zellgröße in px (optional)
  alpha?: number; // Linien-Deckkraft 0..1 (optional)
  color?: string; // RGB oder HEX (optional) – Standard: Primärblau
}
const { class: className, size = 20, alpha = 0.06, color = "#2759FD" } = Astro.props;

// Farbe in CSS-Var schieben; falls HEX -> lassen wir CSS es interpretieren
// für rgba nutzen wir 'color-mix' mit transparent
---

<div class={`paper-grid ${className || ""}`} style={`--paper-grid-size:${size}px; --paper-grid-alpha:${alpha}; --paper-grid-color:${color};`}>
  <slot />
</div>

<style>
  .paper-grid {
    position: relative;
    isolation: isolate;

    /* Stellschrauben */
    --grid-size: 20px; /* Zellgröße */
    --grid-alpha: 0.08; /* Linienstärke / Deckkraft */
    --grid-rgb: 39, 89, 253; /* Primärblau als RGB (2759FD) */

    /* Falls du Props übergibst, überschreiben die inline-Styles unten diese Variablen */
  }

  .paper-grid::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;

    /* Zwei nicht-repeating Gradients + feste Tiles -> keine Subpixel-Drift */
    background-image: linear-gradient(to bottom, rgba(var(--grid-rgb), var(--grid-alpha)) 1px, transparent 1px),
      linear-gradient(to right, rgba(var(--grid-rgb), var(--grid-alpha)) 1px, transparent 1px);
    background-size:
      var(--grid-size) var(--grid-size),
      var(--grid-size) var(--grid-size);
    background-position: top left; /* exakte Ausrichtung auf Pixelraster */
    background-repeat: repeat, repeat;
    background-color: #f8fafc; /* Papierweiß der Vorlage */
  }
</style>
