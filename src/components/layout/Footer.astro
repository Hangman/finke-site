---
import MailIcon from "../../assets/icons/envelope-fill.svg";
import PhoneIcon from "../../assets/icons/telephone-fill.svg";

const year = new Date().getFullYear();

const EMAIL = "kontakt@steuerberatung-finke.de";
const PHONE = "+491716194510";
---

<footer class="bg-white border-t border-slate-200">
  <div class="site-wrap py-10 md:py-12">
    <div class="grid gap-8 md:grid-cols-3 items-start">
      <!-- Brand -->
      <a href="/#home" class="group inline-flex items-center rounded-md transition-colors hover:bg-primary/10">
        <img src="/logo.svg" alt="Logo" class="h-12 w-auto" />
      </a>

      <!-- Seitenlinks -->
      <nav aria-label="Rechtliches" class="text-base">
        <ul class="flex md:flex-col gap-4 md:gap-2">
          <li>
            <a href="/impressum" class="underline-offset-4 font-mono hover:underline text-slate-700 hover:text-primary"> Impressum </a>
          </li>
          <li>
            <a href="/datenschutz" class="underline-offset-4 font-mono hover:underline text-slate-700 hover:text-primary"> Datenschutz </a>
          </li>
        </ul>
      </nav>

      <!-- Kontakt -->
      <div class="text-base">
        <ul class="space-y-2">
          <li class="flex items-center gap-3">
            <MailIcon class="h-5 w-5 text-primary" aria-hidden="true" />
            <a href={`mailto:${EMAIL}`} class="underline-offset-4 font-mono hover:underline text-slate-800 hover:text-primary">
              {EMAIL}
            </a>
          </li>
          <li class="flex items-center gap-3">
            <PhoneIcon class="h-5 w-5 text-primary" aria-hidden="true" />
            <a href={`tel:${PHONE.replace(/\s+/g, "")}`} class="underline-offset-4 font-mono hover:underline text-slate-800 hover:text-primary">
              {PHONE}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <div class="mt-8 pt-6 border-t border-slate-200 text-xs text-slate-500 flex flex-wrap items-center justify-between gap-3"></div>
  </div>
</footer>
