---
const year = new Date().getFullYear();

// TODO: echte Kontaktdaten eintragen
const EMAIL = "kontakt@kanzlei.de";
const PHONE = "+49 123 4567890";
---

<footer class="bg-white border-t border-slate-200">
  <div class="site-wrap py-10 md:py-12">
    <div class="grid gap-8 md:grid-cols-3 items-start">
      <!-- Brand -->
      <a href="#home" class="group inline-flex items-start gap-2" aria-label="Zur Startseite">
        <div class="leading-tight">
          <div class="text-2xl font-bold tracking-tight text-slate-900 group-hover:text-primary transition-colors">Kanzlei&nbsp;Finke</div>
          <div class="text-lg font-medium text-slate-500 group-hover:text-primary/80 transition-colors">Steuerberatung</div>
        </div>
      </a>

      <!-- Seitenlinks -->
      <nav aria-label="Rechtliches" class="text-base">
        <ul class="flex md:flex-col gap-4 md:gap-2">
          <li>
            <a href="/impressum" class="underline-offset-4 hover:underline text-slate-700 hover:text-primary"> Impressum </a>
          </li>
          <li>
            <a href="/datenschutz" class="underline-offset-4 hover:underline text-slate-700 hover:text-primary"> Datenschutz </a>
          </li>
        </ul>
      </nav>

      <!-- Kontakt -->
      <div class="text-base">
        <ul class="space-y-2">
          <li class="flex items-center gap-3">
            <!-- Mail Icon -->
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 text-primary">
              <path
                fill="currentColor"
                d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 2v.01L12 12 4 6.01V6h16ZM4 8.24V20h16V8.24l-7.4 5.18a2 2 0 0 1-2.2 0L4 8.24Z"
              ></path>
            </svg>
            <a href={`mailto:${EMAIL}`} class="underline-offset-4 hover:underline text-slate-800 hover:text-primary">
              {EMAIL}
            </a>
          </li>
          <li class="flex items-center gap-3">
            <!-- Phone Icon -->
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 text-primary">
              <path
                fill="currentColor"
                d="M6.62 10.79a15.91 15.91 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.11.37 2.3.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C11.85 21 3 12.15 3 2a1 1 0 0 1 1-1h3.49a1 1 0 0 1 1 1c0 1.28.2 2.47.57 3.58a1 1 0 0 1-.24 1.01l-2.2 2.2Z"
              ></path>
            </svg>
            <a href={`tel:${PHONE.replace(/\s+/g, "")}`} class="underline-offset-4 hover:underline text-slate-800 hover:text-primary">
              {PHONE}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <div class="mt-8 pt-6 border-t border-slate-200 text-xs text-slate-500 flex flex-wrap items-center justify-between gap-3"></div>
  </div>
</footer>
