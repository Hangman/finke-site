---
import Section from "../layout/Section.astro";

const taetigkeiten = [
  { from: "2008", to: "2011", title: "Duales Studium zur Diplom-Finanzwirtin (FH)", org: "Hochschule für Finanzen NRW", type: "edu" },
  { from: "2012", to: "2014", title: "Master of Laws (LL.M.) Unternehmensteuerrecht", org: "Universität zu Köln", type: "work" },
  { from: "2015", title: "Steuerberaterexamen", org: "erfolgreich abgelegt", type: "edu" },
  { from: "2021", to: "2024", title: "Master of Public Management (MPM)", org: "HSPV NRW", type: "work" },
  { from: "2011", to: "2014", title: "Veranlagung – Einzelunternehmen", org: "Finanzverwaltung NRW", type: "edu" },
  { from: "2015", to: "2016", title: "Betriebsprüferin – KMU", org: "Finanzverwaltung NRW", type: "work" },
  {
    from: "2016",
    to: "07/2024",
    title: "Betriebsprüferin – Großbetriebe & Konzerne",
    org: "Finanzverwaltung NRW",
    note: "Schwerpunkt: Auslandsfachprüfung",
    type: "edu",
  },
  { from: "seit 2022", title: "Coach für Prüfungsvorbereitung · Gesellschafterin", org: "JES GbR", link: "#", type: "work" },
  { from: "seit 2022", title: "Dozentin (AO, ErbSt, Int. Steuerrecht)", org: "Studienwerk der Steuerberater", type: "edu" },
  { from: "seit 08/2024", title: "Bestellte Steuerberaterin, eigene Kanzlei", org: "Sophie Finke Steuerberatung", type: "work" },
];

/** Hilfsfunktionen: Datum in Sortierschlüssel (für „neu → alt“) */
function toKey(v) {
  // akzeptiert "seit 08/2024", "07/2024", "2024"
  const m = String(v).match(/(\d{2})\/(\d{4})|(\d{4})/);
  if (!m) return 0;
  const year = m[2] ? Number(m[2]) : Number(m[3]);
  const month = m[1] ? Number(m[1]) : 12; // „seit YYYY“ → treat as Dezember für Sortierung (ziemlich neu)
  return year * 100 + month;
}

/** Alternation: wir lassen left/right durch type vorgeben
    – edu -> links; work -> rechts; (damit „erst das eine, dann das andere usw.“) */
function sideFor(item) {
  return item.type === "edu" ? "left" : "right";
}
---

<Section id="about" eyebrow="About" title="Werdegang & Erfahrung">
  <p class="pt-4 max-w-3xl text-slate-700 mb-8">
    Fundiertes Fachwissen aus Verwaltung und Lehre, kombiniert mit praktischer Prüfungserfahrung: Ausbildung und Tätigkeiten bilden die Basis für klare,
    belastbare Beratung – von der Betriebsprüfung bis zur Nachfolgeplanung.
  </p>

  <!-- Wrapper: Mittelachse absolut, Einträge in Grid -->
  <div class="relative">
    <!-- Mittelachse (nur >= md sichtbar) -->
    <div class="hidden md:block absolute left-1/2 -translate-x-1/2 top-0 bottom-0 w-1 rounded-sm bg-primary/50"></div>

    <!-- Alternierende Timeline -->
    <ol class="grid gap-y-4 md:gap-y-0 md:grid-cols-2">
      {
        taetigkeiten.map((item) => {
          const isLeft = sideFor(item) === "left";

          const Card = (
            <li class={`relative ${isLeft ? "md:pr-10" : "md:pl-10"}`}>
              {/* Mobile: einfache linke Linie + Marker */}
              <span class="absolute left-[10px] top-[26px] h-[2px] w-6 bg-primary/40 md:hidden" />
              <span class="absolute left-[15px] top-[20px] h-2.5 w-2.5 rounded-full bg-primary md:hidden" />

              {/* Desktop: Connector/Marker zur Mittelachse */}
              {isLeft ? (
                <>
                  {/* von Boxkante (right:0) bis Achse */}
                  <span class="hidden md:block absolute top-[26px] right-0 w-10 h-[2px] bg-primary/80" />
                  {/* Marker auf Achse */}
                  <span class="hidden md:block absolute top-[20px] -right-[7px] h-3.5 w-3.5 rounded-full bg-primary" />
                </>
              ) : (
                <>
                  {/* von Boxkante (left:0) bis Achse */}
                  <span class="hidden md:block absolute top-[26px] left-0 w-10 h-[2px] bg-primary/80" />
                  {/* Marker auf Achse */}
                  <span class="hidden md:block absolute top-[20px] -left-[7px] h-3.5 w-3.5 rounded-full bg-primary" />
                </>
              )}

              {/* Box */}
              <div class="rounded-lg bg-white ring-1 ring-black/10 p-4">
                <div class="text-sm mb-1 text-primary">
                  {item.to ? (
                    <span>
                      <time>{item.from}</time>–<time>{item.to}</time>
                    </span>
                  ) : (
                    <span>
                      <time>{item.from}</time>
                    </span>
                  )}
                </div>
                <div class="font-semibold text-slate-900">{item.title}</div>
                <div class="text-slate-600 text-sm">
                  {item.link ? (
                    <a href={item.link} target="_blank" rel="noopener" class="underline underline-offset-2 decoration-primary/40 hover:text-primary">
                      {item.org}
                    </a>
                  ) : (
                    item.org
                  )}
                </div>
                {item.note && <div class="text-slate-600 text-sm mt-1">{item.note}</div>}
              </div>
            </li>
          );

          const Spacer = <li class="hidden md:block" aria-hidden="true" />;

          // Reihenaufbau: [Card|Spacer] für links, [Spacer|Card] für rechts
          return isLeft ? [Card, Spacer] : [Spacer, Card];
        })
      }
    </ol>
  </div>
</Section>
