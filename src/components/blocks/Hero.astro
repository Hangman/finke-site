---
import Section from "../layout/Section.astro";
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";

interface Props {
  id?: string;
  class?: string;
}
const { id = "home", class: className } = Astro.props;
---

<Section id={id} class={`pt-24 ${className || ""}`}>
  <div class="grid lg:grid-cols-2 gap-8 items-center">
    <div>
      <Eyebrow class="mb-4">Strategische Steuerberatung</Eyebrow>
      <h1 class="font-bold tracking-tight text-4xl md:text-6xl mb-5">Steuerberatung, die Klarheit schafft</h1>
      <p class="text-slate-600 text-lg mb-6">Fundiert, praxisnah und aufmerksam – von der Betriebsprüfung bis zur Nachfolgeplanung.</p>
      <div class="flex flex-wrap gap-3">
        <Button href="#services" variant="primary" size="lg">Leistungen ansehen</Button>
        <Button href="mailto:kontakt@kanzlei.de" variant="outline" size="lg">Kontakt aufnehmen</Button>
      </div>
    </div>

    <!-- Bildkarte, später Bild ersetzen -->
    <div class="rounded-2xl bg-white shadow-md ring-1 ring-black/5 p-2">
      <div class="aspect-[16/11] w-full rounded-xl bg-slate-200"></div>
    </div>
  </div>
</Section>
