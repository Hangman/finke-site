---
import Section from "../layout/Section.astro";
import Button from "../ui/Button.astro";
import { Image } from "astro:assets";
import hero from "../../assets/hero.png";

interface Props {
  id?: string;
  class?: string;
}
const { id = "home", class: className } = Astro.props;
---

<Section id={id} class={`pt-8 md:pt-44 md:pb-36 scroll-mt-28 ${className || ""}`}>
  <div class="grid md:grid-cols-[minmax(0,1fr)_auto] gap-8 items-center">
    <div class="min-w-0">
      <h1 class="font-bold tracking-tight text-4xl md:text-6xl mb-5 leading-tight">
        <span class="text-primary">Steuerberatung,</span><br />
        die Klarheit schafft
      </h1>
      <p class="text-slate-600 text-lg mb-6">Fundiert, praxisnah und aufmerksam – von der Betriebsprüfung bis zur Nachfolgeplanung.</p>
      <div class="flex flex-wrap gap-3">
        <Button href="#services" variant="primary" size="xl">Leistungen ansehen</Button>
        <Button href="#contact" variant="outline" size="xl">Kontakt aufnehmen</Button>
      </div>
    </div>

    <!-- Portrait mit Hintergrund -->
    <div class="relative rounded-2xl bg-white shadow-md ring-1 ring-black/10 p-2 overflow-hidden md:justify-self-start md:w-[min(480px,40vw)]">
      <div class="hero-image-wrapper rounded-xl overflow-hidden">
        <Image
          src={hero}
          alt="Portrait der Steuerberaterin"
          class="relative z-10 w-full md:w-auto h-auto md:max-h-[68vh]"
          widths={[400, 600, 800, 1000, 1200]}
          sizes="(max-width: 767px) 100vw, (max-width: 1199px) 40vw, 480px"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</Section>

<style>
  .hero-image-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: 0.75rem;
    background: #e8edfa; /* ruhiger, solider Grundton */
    isolation: isolate;
  }

  /* Großer Kreis oben als dezenter Akzent */
  .hero-image-wrapper::before {
    content: "";
    position: absolute;
    top: -30%; /* etwas außerhalb, nur Teil sichtbar */
    left: -20%;
    width: 160%;
    height: 160%;
    border-radius: 50%;
    background: rgba(39, 89, 253, 0.15); /* Primärblau mit starker Transparenz */
    z-index: 0;
  }

  /* Portrait oben drauf */
  .hero-image-wrapper img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
  }
</style>
