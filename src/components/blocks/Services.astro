---
import Section from "../layout/Section.astro";

/** Daten -> falls du später Texte ändern willst, hier zentral */
const services = [
  {
    key: "reorg",
    title: "Umstrukturierungen",
    icon: "/icons/reorg.svg",
    claim: "Rechtssicher und steueroptimiert in die nächste Unternehmensphase - ich berate Sie unter anderem zu folgenden Themen:",
    points: ["Rechtsformwahl", "Holding- & Konzernstrukturen", "Vorgänge nach dem Umwandlungssteuergesetz", "Nachfolgeplanung im Unternehmen"],
  },
  {
    key: "private",
    title: "Nachfolgeplanung",
    icon: "/icons/private.svg",
    claim:
      "Vermögensnachfolge ist ein sensibles Thema. Umso wichtiger ist es, die steuerlichen Möglichkeiten und Konsequenzen frühzeitig zu kennen - und auf dieser Basis eine passende Gestaltung zu wählen.",
    points: [
      "Bewertungen von Vermögen und Schulden",
      "Optimierung der Erbschaft- & Schenkungsteuer",
      "Nießbrauch, Leibrente, Versorgungsleistungen",
      "Familiengesellschaften",
    ],
  },
  {
    key: "audit",
    title: "Begleitung von Betriebsprüfungen",
    icon: "/icons/audit.svg",
    claim: "Ich unterstütze Sie mit meiner langjährigen Erfahrung als ehemalige Prüferin:",
    points: ["Beantwortung von Anfragen", "Begleitung und Beratung bei Zwischen- und Schlussbesprechungen", "Bescheidprüfung und Einwendungen"],
  },
  {
    key: "advice",
    title: "Beratung für Berater",
    icon: "/icons/advice.svg",
    claim:
      "Ich kenne die Finanzverwaltung aus der Innenperspektive und teile mein Wissen und meine Erfahrungen gern mit Kolleginnen und Kollegen aus dem Berufsstand:",
    points: [
      "Einspruchs- und Klageverfahren (auch bei Untätigkeit)",
      "Beantragung verbindlicher Auskünfte",
      "Begleitung von Anhörungen",
      "Geltendmachung von Amtshaftung",
    ],
  },
];
---

<Section id="services" eyebrow="Leistungen" title="Beratung mit Klarheit – vor allem für Sie">
  <div class="mt-6 grid gap-6 md:gap-8 md:grid-cols-2 md:auto-rows-fr">
    {
      services.map((s) => (
        <article class="relative h-full flex flex-col rounded-xl bg-white ring-1 ring-black/10 shadow-sm">
          <span class="absolute left-0 top-0 h-full w-1.5 rounded-l-xl bg-primary/80" />

          <div class="flex items-center justify-between px-5 pt-5 gap-3">
            <div class="text-primary">{s.icon && <img src={s.icon} alt="" class="w-12 h-12 shrink-0 opacity-90" loading="lazy" />}</div>
            <h3 class="text-xl font-semibold tracking-tight text-slate-900 flex-1">{s.title}</h3>
          </div>

          <p class="px-5 mt-2 text-slate-600 text-base leading-relaxed tracking-tight">{s.claim}</p>

          <ul class="mt-4 px-5 pb-5 space-y-2 text-base tracking-tight font-medium text-slate-600 flex-1">
            {s.points.map((p) => (
              <li class="flex items-start gap-2">
                <span class="mt-2 h-[8px] w-[8px] min-h-[8px] min-w-[8px] rounded-full bg-primary/70" />
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>
