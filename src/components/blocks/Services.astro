---
import Section from "../layout/Section.astro";

/** Daten -> falls du später Texte ändern willst, hier zentral */
const services = [
  {
    key: "reorg",
    title: "Unternehmensumstrukturierung & Nachfolgeberatung",
    icon: "/icons/reorg.svg",
    claim:
      "Im unternehmerischen Alltag bleibt oft wenig Zeit, sich um die eigene Struktur oder Nachfolge zu kümmern – beides kann jedoch bares Geld kosten. Ich unterstütze Sie dabei, rechtssicher und steueroptimiert in die nächste Unternehmensphase zu gehen und berate Sie unter anderem zu folgenden Themen:",
    points: [
      "Rechtsformwahl & Umwandlungssteuerrecht",
      "Holding- & Konzernstrukturen",
      "Steuerneutrale Vorgänge nach dem Umwandlungssteuergesetz",
      "Nachfolgeplanung im Unternehmen",
      "Kalkulation erbschaft- und schenkungsteuerlicher Begünstigungen",
    ],
  },
  {
    key: "private",
    title: "Private Nachfolgeplanung (Erbschaft & Schenkung)",
    icon: "/icons/private.svg",
    claim:
      "Die private Vermögensnachfolge ist für viele Familien ein sensibles Thema. Umso wichtiger ist es, die steuerlichen Möglichkeiten und Konsequenzen frühzeitig zu kennen – und auf dieser Basis eine passende Gestaltung zu wählen. Ich helfe Ihnen, Ihr Vermögen vorausschauend und klar zu strukturieren, damit Werte erhalten und Streitigkeiten vermieden werden.",
    points: [
      "Bewertung von Vermögensgegenständen und Verbindlichkeiten nach dem Bewertungsgesetz",
      "Erbschaft- & Schenkungsteuer-Optimierung",
      "Schenkungskonzepte mit Nießbrauch, Leibrente, gemischter Schenkung oder Versorgungsleistungen",
      "Gründung von Familiengesellschaften",
      "Abstimmung mit Notariat & Rechtsberatung",
    ],
  },
  {
    key: "audit",
    title: "Begleitung von Betriebsprüfungen",
    icon: "/icons/audit.svg",
    claim:
      "Eine Prüfungsanordnung kommt selten gelegen – und löst meist weder beim Mandanten noch beim Berater Begeisterung aus. sondern weil die Betreuung einer Prüfung viel Zeit und Ressourcen bindet. Ich unterstütze Sie im gesamten Verlauf der Prüfung – von der Vorbereitung bis zum Abschluss – mit Erfahrung, Strategie und einem klaren Blick auf das Wesentliche.",
    points: [
      "Beantwortung von Anfragen im Rahmen der Prüfung",
      "Begleitung und strategische Beratung bei Zwischen- und Schlussbesprechungen mit der Finanzverwaltung",
      "Bescheidprüfung und Rechtsbehelf",
      "Erfolgsanalyse von Einwendungen",
    ],
  },
  {
    key: "advice",
    title: "Beratung für Berater",
    icon: "/icons/advice.svg",
    claim:
      "Ich kenne die Finanzverwaltung aus der Innenperspektive – mit all ihren Abläufen, Verfahrensschritten und Entscheidungswegen. Diese Erfahrung nutze ich, um Kolleginnen und Kollegen zielgerichtet zu unterstützen – insbesondere dann, wenn strategisches oder rechtliches Feingefühl gefragt ist.",
    points: [
      "Einspruchs- und Klageverfahren (auch bei Untätigkeit)",
      "Beantragung verbindlicher Auskünfte und strategische Einschätzung dazu",
      "Vorbereitung und Begleitung von Anhörungen",
      "Unterstützung bei der Geltendmachung von Amtshaftungsansprüchen",
    ],
  },
];
---

<Section id="services" eyebrow="Leistungen" title="Beratung mit Klarheit – vor allem für Sie">
  <div class="mt-6 grid gap-6 md:gap-8 md:grid-cols-2 md:auto-rows-fr">
    {
      services.map((s) => (
        <article class="relative h-full flex flex-col rounded-xl bg-white ring-1 ring-black/10 shadow-sm">
          <span class="absolute left-0 top-0 h-full w-1.5 rounded-l-xl bg-primary/80" />

          <div class="flex items-center justify-between px-5 pt-5 gap-3">
            <div class="text-primary">{s.icon && <img src={s.icon} alt="" class="w-12 h-12 shrink-0 opacity-90" loading="lazy" />}</div>
            <h3 class="text-xl font-semibold tracking-tight text-slate-900 flex-1">{s.title}</h3>
          </div>

          <p class="px-5 mt-2 text-slate-600 text-base leading-relaxed tracking-tight">{s.claim}</p>

          <ul class="mt-4 px-5 pb-5 space-y-2 text-base tracking-tight font-medium text-slate-600 flex-1">
            {s.points.map((p) => (
              <li class="flex items-start gap-2">
                <span class="mt-2 h-[8px] w-[8px] min-h-[8px] min-w-[8px] rounded-full bg-primary/70" />
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>
