---
import Section from "../layout/Section.astro";

/** Daten -> falls du später Texte ändern willst, hier zentral */
const services = [
  {
    key: "audit",
    title: "Betriebsprüfungs­begleitung",
    claim: "Gelassen durch die Prüfung – von der Vorbereitung bis zum Abschluss.",
    points: [
      "Risikoanalyse & Dokumenten-Check",
      "Begleitung von Gesprächen mit der Finanzverwaltung",
      "Prüfungsstrategie, Argumentation & Einwendungen",
      "Abschlussbesprechung, Bescheidprüfung & Rechtsbehelf"
    ]
  },
  {
    key: "reorg",
    title: "Unternehmens­umstrukturierung & Nachfolge­beratung",
    claim: "Rechtssicher und steueroptimiert in die nächste Unternehmensphase.",
    points: [
      "Rechtsformwahl & Umwandlungssteuerrecht",
      "Holding- & Konzernstrukturen",
      "Gesellschafterwechsel, Management-Buy-in/-out",
      "Nachfolgeplanung im Unternehmen"
    ]
  },
  {
    key: "private",
    title: "Private Nachfolgeplanung (Erbschaft & Schenkung)",
    claim: "Vermögen übergeben, Werte erhalten – mit steuerlicher Klarheit.",
    points: [
      "Erbschaft- & Schenkungsteuer-Optimierung",
      "Schenkungskonzepte mit Nießbrauch/Leibrente",
      "Familiengesellschaften & Testamentsvollstreckung",
      "Abstimmung mit Notariat & Rechtsberatung"
    ]
  },
  {
    key: "advice",
    title: "Beratung für Berater",
    claim: "Hilfe beim Umgang mit der Finanzbehörde.",
    points: [
      "Pipapo",
      "Lorem Ipsum",
      "Raffzahnbeseitigung",
      "Unkrautverwertung"
    ]
  }
];
---

<Section id="services" eyebrow="Leistungen" title="Beratung mit Fokus & Klarheit" class="pt-8">
  <!-- Karten-Grid -->
  <div class="mt-6 grid gap-6 md:gap-8 md:grid-cols-2 md:auto-rows-fr">
  {services.map((s) => (
    <article class="relative h-full flex flex-col rounded-xl bg-white ring-1 ring-black/10 shadow-sm">
      
      <!-- linke Akzentleiste -->
      <span class="absolute left-0 top-0 h-full w-1.5 rounded-l-xl bg-primary/80"></span>

      <div class="px-5 pt-5">
          <span class="inline-flex h-9 w-9 items-center justify-center rounded-md bg-primary/10 ring-1 ring-primary/25">
            <!-- kleines Akzent-Icon nur mit CSS -->
            <span class="relative inline-block h-5 w-4">
              <span class="absolute inset-0 rounded-[2px] border border-primary/70 bg-white"></span>
              <span class="absolute left-0.5 right-0.5 top-1 h-[2px] bg-primary/60"></span>
              <span class="absolute left-0.5 right-0.5 top-[10px] h-[2px] bg-primary/60"></span>
              <span class="absolute left-0.5 right-2 top-[6px] h-[2px] bg-primary/40"></span>
            </span>
          </span>
        </div>

      <div class="px-5">
        <h3 class="mt-3 text-xl font-semibold tracking-tight text-slate-900">
          {s.title}
        </h3>
        <p class="mt-2 text-slate-600 text-lg leading-relaxed tracking-tight">
          {s.claim}
        </p>
      </div>

      <!-- Flex-Füller, damit die Liste/CTA nach unten gedrückt wird -->
      <ul class="mt-4 px-5 pb-5 space-y-2 text-base tracking-tight font-medium text-slate-600 flex-1">
        {s.points.map((p) => (
          <li class="flex items-start gap-2">
            <span class="mt-2 h-[8px] w-[8px] min-h-[8px] min-w-[8px] rounded-full bg-primary/70"></span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </article>
  ))}
</div>
</Section>
