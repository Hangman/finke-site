---
import Section from "../layout/Section.astro";
import Button from "../ui/Button.astro";

import WhatsappIcon from "../../assets/icons/whatsapp.svg";
import MailIcon from "../../assets/icons/envelope.svg";
import PhoneIcon from "../../assets/icons/telephone.svg";
import MailIconFill from "../../assets/icons/envelope-fill.svg";
import PhoneIconFill from "../../assets/icons/telephone-fill.svg";

const EMAIL = "kontakt@steuerberatung-finke.de";
const PHONE_DISPLAY = "+49 171 6194510";
const PHONE_TEL = "+491716194510"; // international, ohne Leerzeichen/Bindestriche
const WHATSAPP_INT = "491716194510"; // international OHNE Plus, OHNE führende 0
const DEFAULT_MSG = "Guten Tag, ich habe eine Frage zur Steuerberatung.";
const waUrl = `https://wa.me/${WHATSAPP_INT}?text=${encodeURIComponent(DEFAULT_MSG)}`;
---

<Section id="contact" eyebrow="Kontakt" title="Lernen wir uns kennen">
  <div class="grid gap-8 md:grid-cols-2 items-start">
    <div>
      <p class="pt-4 text-slate-700 leading-relaxed">
        Kurzes Anliegen oder konkrete Fragestellung? Schreiben Sie mir per E-Mail, rufen Sie an – oder nutzen Sie WhatsApp für eine schnelle Abstimmung. Ich
        melde mich zeitnah zurück.
      </p>

      <ul class="mt-6 space-y-3 text-slate-700">
        <li class="flex items-center gap-3">
          <MailIcon class="h-5 w-5 text-primary" aria-hidden="true" />
          <a class="underline underline-offset-2 decoration-primary/40 hover:text-primary" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </li>

        <li class="flex items-center gap-3">
          <PhoneIcon class="h-5 w-5 text-primary" aria-hidden="true" />
          <a class="underline underline-offset-2 decoration-primary/40 hover:text-primary" href={`tel:${PHONE_TEL}`}>{PHONE_DISPLAY}</a>
        </li>

        <li class="flex items-center gap-3">
          <WhatsappIcon class="h-5 w-5 text-primary" aria-hidden="true" />
          <a class="underline underline-offset-2 decoration-primary/40 hover:text-primary" href={waUrl} target="_blank" rel="noopener">WhatsApp Nachricht</a>
        </li>
      </ul>
    </div>

    <!-- Buttonseite -->
    <div class="rounded-2xl bg-white ring-1 ring-black/10 shadow-sm p-4 md:p-6">
      <div class="space-y-3">
        <Button href={`mailto:${EMAIL}`} variant="primary" size="lg" class="w-full justify-center">
          <MailIconFill class="h-4 w-4" />
          <span>E-Mail senden</span>
        </Button>

        <Button href={`tel:${PHONE_TEL}`} variant="outline" size="lg" class="w-full justify-center">
          <PhoneIconFill class="h-4 w-4 text-primary" />
          <span>Jetzt anrufen</span>
        </Button>

        <Button href={waUrl} variant="outline" size="lg" class="w-full justify-center">
          <WhatsappIcon class="h-4 w-4 text-primary" />
          <span>WhatsApp schreiben</span>
        </Button>
      </div>

      <!-- Direkt weiterhin die reinen Links anbieten -->
      <div class="mt-4 text-xs text-slate-500">
        Alternativ: <a class="underline underline-offset-2 decoration-primary/40 hover:text-primary" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        &middot; <a class="underline underline-offset-2 decoration-primary/40 hover:text-primary" href={`tel:${PHONE_TEL}`}>{PHONE_DISPLAY}</a>
      </div>
    </div>
  </div>
</Section>
