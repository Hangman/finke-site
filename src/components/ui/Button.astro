---
interface Props {
  href?: string;
  variant?: "primary" | "outline";
  size?: "sm" | "md" | "lg";
  class?: string;
  type?: "button" | "submit" | "reset";
}
const { href, variant = "primary", size = "md", class: className, type = "button" } = Astro.props;
const base = `btn ${className || ""}`;
const attrs = { "data-variant": variant, "data-size": size };
---

{
  href ? (
    <a href={href} class={base} {...attrs}>
      <slot />
    </a>
  ) : (
    <button type={type} class={base} {...attrs}>
      <slot />
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 0.5rem; /* rounded-lg */
    padding: 0.625rem 1rem; /* py-2.5 px-4 */
    font-size: 0.875rem; /* text-sm */
    font-family: "GeistMono", ui-monospace, monospace;
    font-weight: 500; /* font-medium */
    line-height: 1.2;
    transition:
      color 0.2s,
      background-color 0.2s,
      border-color 0.2s,
      box-shadow 0.2s;
    outline: none;
  }
  .btn:focus-visible {
    box-shadow:
      0 0 0 2px white,
      0 0 0 4px var(--color-primary, #2759fd);
  }

  /* Variants */
  .btn[data-variant="primary"] {
    color: #fff;
    background: var(--color-primary, #2759fd);
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.04);
  }
  .btn[data-variant="primary"]:hover {
    background: var(--color-primary-600, #1f48cc);
  }

  .btn[data-variant="outline"] {
    color: var(--color-primary, #2759fd);
    background: #fff;
    border: 1px solid var(--color-primary, #2759fd);
  }
  .btn[data-variant="outline"]:hover {
    background: color-mix(in srgb, var(--color-primary, #2759fd) 10%, white);
  }

  /* Sizes */
  .btn[data-size="sm"] {
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
  } /* text-xs */
  .btn[data-size="md"] {
    /* default oben */
  }
  .btn[data-size="lg"] {
    padding: 0.75rem 1.25rem;
    font-size: 1rem;
  } /* text-base */
</style>
