---
interface Props {
  href?: string;
  variant?: "primary" | "outline";
  size?: "sm" | "md" | "lg" | "xl";
  class?: string;
  type?: "button" | "submit" | "reset";
}
const { href, variant = "primary", size = "md", class: className, type = "button" } = Astro.props;
const base = `btn ${className || ""}`;
const attrs = { "data-variant": variant, "data-size": size };
---

{
  href ? (
    <a href={href} class={base} {...attrs}>
      <slot />
    </a>
  ) : (
    <button type={type} class={base} {...attrs}>
      <slot />
    </button>
  )
}

<style>
  .btn {
    /* gemeinsame Rundung */
    --btn-radius: 0.4rem; /* ← hier einmal steuern (z.B. 0.3rem für eckiger) */

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: var(--btn-radius);
    padding: 0.625rem 1rem; /* md default */
    font-size: 0.875rem; /* text-sm */
    font-weight: 500;
    line-height: 1.2;
    transition:
      color 0.2s,
      background-color 0.2s,
      border-color 0.2s,
      box-shadow 0.2s;
    outline: none;
    font-family: "GeistMono", ui-monospace, SFMono-Regular, Menlo, monospace;
    position: relative;
  }

  .btn:focus-visible {
    box-shadow:
      0 0 0 2px white,
      0 0 0 4px var(--color-primary, #2759fd);
  }

  .btn[data-variant="primary"] {
    /* dashed-Farbe als Variable auf dem Button definieren,
     damit wir sie im :hover dunkler machen können */
    --dash-color: #497ff7;

    color: #fff;
    background: var(--color-primary, #2759fd);
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.04);
  }

  .btn[data-variant="primary"]:hover {
    background: color-mix(in srgb, var(--color-primary, #2759fd) 82%, black);
  }

  .btn[data-variant="primary"]:hover {
    --dash-color: color-mix(in srgb, #497ff7 85%, black);
  }

  .btn[data-variant="primary"]::after {
    content: "";
    position: absolute;
    inset: 0px;
    border-radius: var(--btn-radius);
    border: 2px dashed var(--dash-color);
    pointer-events: none;
  }

  .btn[data-variant="outline"] {
    color: var(--color-primary, #2759fd);
    background: #fff;
    border: 2px solid var(--color-primary, #2759fd);
  }
  .btn[data-variant="outline"]:hover {
    background: color-mix(in srgb, var(--color-primary, #2759fd) 10%, white);
  }

  /* ===== Sizes ===== */
  /* wenn du je Größe eine andere Rundung willst, hier addieren/überschreiben */
  .btn[data-size="sm"] {
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
  }
  .btn[data-size="md"] {
    /* default oben */
  }
  .btn[data-size="lg"] {
    padding: 0.75rem 1.25rem;
    font-size: 1rem;
  }
  .btn[data-size="xl"] {
    font-size: 1rem;
    padding: 1rem 1.26rem;
    border-radius: var(--btn-radius); /* nicht mehr zwangsweise runder */
  }
</style>
