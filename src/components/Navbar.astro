---
const links = [
  { href: "#home", label: "Home" },
  { href: "#about", label: "Über mich" },
  { href: "#services", label: "Leistungen" },
  { href: "#faq", label: "FAQ" },
  { href: "#contact", label: "Kontakt" },
];
---

<nav
  class="fixed inset-x-0 top-0 z-50 bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/70 border-b border-black/5 shadow-[0_1px_8px_rgba(0,0,0,0.06)]"
>
  <div class="site-wrap">
    <div class="flex h-16 items-center justify-between">
      <!-- Brand -->
      <a href="#home" class="flex items-center gap-2 tap-target">
        <span class="inline-block h-6 w-6 rounded-sm border border-blue-500"></span>
        <span class="font-heading text-lg tracking-tight">Kanzlei&nbsp;Name</span>
      </a>

      <!-- Desktop -->
      <ul class="hidden md:flex items-center gap-6">
        {
          links.map(({ href, label }) => (
            <li>
              <a href={href} class="nav-link">
                {label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Burger (KEIN onClick, stattdessen ID) -->
      <button id="menuButton" class="md:hidden tap-target" aria-expanded="false" aria-controls="mobileMenu">
        <span class="sr-only">Menü öffnen</span>
        <div class="grid place-items-center h-6 w-6">
          <div class="h-[2px] w-5 bg-gray-800"></div>
          <div class="h-[2px] w-5 bg-gray-800 mt-1.5"></div>
          <div class="h-[2px] w-5 bg-gray-800 mt-1.5"></div>
        </div>
      </button>
    </div>
  </div>

  <!-- Mobile-Panel -->
  <div
    id="mobileMenu"
    data-open="false"
    class="md:hidden overflow-hidden transition-[max-height,opacity] duration-300 ease-out"
    style="max-height: 0; opacity: 0;"
  >
    <div class="site-wrap py-2">
      <ul class="flex flex-col">
        {
          links.map(({ href, label }) => (
            <li>
              <a href={href} class="nav-link block py-3">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- JS: Handler registrieren -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const btn = document.getElementById("menuButton");
      const panel = document.getElementById("mobileMenu");
      if (!btn || !panel) return;

      const update = () => {
        const open = panel.dataset.open === "true";
        panel.style.maxHeight = open ? panel.scrollHeight + "px" : "0px";
        panel.style.opacity = open ? "1" : "0";
        btn.setAttribute("aria-expanded", String(open));
      };

      const toggle = () => {
        panel.dataset.open = panel.dataset.open === "true" ? "false" : "true";
        update();
      };

      btn.addEventListener("click", toggle);

      // Beim Link-Klick Panel schließen
      panel.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => {
          panel.dataset.open = "false";
          update();
        })
      );

      // Falls offen, Höhe bei Resize aktualisieren
      window.addEventListener("resize", () => {
        if (panel.dataset.open === "true") {
          panel.style.maxHeight = panel.scrollHeight + "px";
        }
      });

      update(); // Initial
    });
  </script>
</nav>
