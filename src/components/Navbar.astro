---
const links = [
  { href: "/#home", label: "Home" },
  { href: "/#services", label: "Leistungen" },
  { href: "/#about", label: "Über mich" },
  { href: "/#faq", label: "FAQ" },
  { href: "/#contact", label: "Kontakt" },
];
---

<nav class="fixed inset-x-0 top-0 z-50 bg-white border-b border-black/15 shadow-[0_1px_8px_rgba(0,0,0,0.5)]">
  <div class="site-wrap">
    <div class="flex h-18 items-center justify-between">
      <!-- Brand -->
      <a href="/#home" class="group inline-flex gap-2" aria-label="Zur Startseite">
        <div class="leading-tight">
          <div class="text-2xl font-bold tracking-tight text-slate-900 group-hover:text-primary transition-colors">Sophie&nbsp;Finke</div>
          <div class="text-lg font-medium text-primary group-hover:text-primary/80 transition-colors">Steuerberatung</div>
        </div>
      </a>

      <!-- Desktop -->
      <ul class="hidden md:flex items-center gap-8">
        {
          links.map(({ href, label }) => (
            <li>
              <a href={href} class="nav-link text-lg font-medium font-mono">
                {label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Burger (KEIN onClick, stattdessen ID) -->
      <button id="menuButton" class="md:hidden tap-target group" aria-expanded="false" aria-controls="mobileMenu">
        <span class="sr-only">Menü öffnen</span>

        <!-- Burger -> X -->
        <span class="relative block h-5 w-6">
          <!-- Linie 1 -->
          <span
            class="rounded absolute left-0 top-0 h-[3px] w-7 bg-gray-800 transition-transform duration-200 ease-out
             group-aria-expanded:translate-y-[10px] group-aria-expanded:rotate-45"
          ></span>
          <!-- Linie 2 -->
          <span
            class="rounded absolute left-0 top-[10px] h-[3px] w-7 bg-gray-800 transition-all duration-200 ease-out
             group-aria-expanded:opacity-0"
          ></span>
          <!-- Linie 3 -->
          <span
            class="rounded absolute left-0 top-[20px] h-[3px] w-7 bg-gray-800 transition-transform duration-200 ease-out
             group-aria-expanded:-translate-y-[10px] group-aria-expanded:-rotate-45"
          ></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile-Panel -->
  <div
    id="mobileMenu"
    data-open="false"
    class="md:hidden overflow-hidden transition-[max-height,opacity] duration-300 ease-out"
    style="max-height: 0; opacity: 0;"
  >
    <div class="site-wrap py-2">
      <ul class="flex flex-col">
        {
          links.map(({ href, label }) => (
            <li>
              <a href={href} class="nav-link block py-3 text-2xl font-medium font-mono">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- JS: Handler registrieren -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const btn = document.getElementById("menuButton");
      const panel = document.getElementById("mobileMenu");
      if (!btn || !panel) return;

      const update = () => {
        const open = panel.dataset.open === "true";
        panel.style.maxHeight = open ? panel.scrollHeight + "px" : "0px";
        panel.style.opacity = open ? "1" : "0";
        btn.setAttribute("aria-expanded", String(open));
      };

      const toggle = () => {
        panel.dataset.open = panel.dataset.open === "true" ? "false" : "true";
        update();
      };

      btn.addEventListener("click", toggle);

      // Beim Link-Klick Panel schließen
      panel.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => {
          panel.dataset.open = "false";
          update();
        })
      );

      // Falls offen, Höhe bei Resize aktualisieren
      window.addEventListener("resize", () => {
        if (panel.dataset.open === "true") {
          panel.style.maxHeight = panel.scrollHeight + "px";
        }
      });

      update(); // Initial
    });
  </script>
</nav>
